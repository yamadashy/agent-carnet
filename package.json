{
  "name": "agent-carnet",
  "version": "0.1.5",
  "description": "File-based markdown notebook CLI for AI agents — the leather notebook in your jacket pocket.",
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "default": "./dist/index.mjs"
    }
  },
  "bin": {
    "agent-carnet": "dist/bin/agent-carnet.mjs"
  },
  "files": [
    "dist/",
    "docs/logo.svg",
    "skills/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepare": "node --run build",
    "build": "tsdown",
    "dev": "tsdown --watch",
    "agent-carnet": "node --run build && node dist/bin/agent-carnet.mjs",
    "lint": "node --run lint-biome && node --run lint-oxlint && node --run lint-ts && node --run lint-secretlint",
    "lint-biome": "biome check --write",
    "lint-oxlint": "oxlint --fix",
    "lint-ts": "tsc --noEmit",
    "lint-secretlint": "secretlint \"**/*\" --secretlintignore .gitignore",
    "test": "vitest run",
    "test-coverage": "vitest run --coverage"
  },
  "keywords": [
    "agent",
    "ai",
    "ai-agent",
    "cli",
    "markdown",
    "memory",
    "notebook",
    "notes",
    "llm"
  ],
  "author": "Kazuki Yamada <koukun0120@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yamadashy/agent-carnet.git"
  },
  "bugs": {
    "url": "https://github.com/yamadashy/agent-carnet/issues"
  },
  "homepage": "https://github.com/yamadashy/agent-carnet",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "parse-duration": "^2.1.8",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.5",
    "@types/node": "^25.9.5",
    "@vitest/coverage-v8": "^4.1.11",
    "oxlint": "^1.80.0",
    "secretlint": "^13.0.5",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
